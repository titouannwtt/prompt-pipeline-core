{
  "name": "prompt-pipeline-core",
  "version": "0.2.0",
  "description": "Prompt Pipeline Core: the standalone, reproducible encryption module (Argon2id + AES-256-GCM, non-extractable key, versioned KDF header). Zero runtime dependency.",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/titouannwtt/prompt-pipeline-core.git"
  },
  "main": "./dist/prompt-pipeline-core.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/prompt-pipeline-core.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "prompt-pipeline-core": "./bin/verify.mjs"
  },
  "files": [
    "src",
    "scripts",
    "bin",
    "dist",
    "releases",
    "examples",
    "verify-bookmarklet.js",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "prepare": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fast-check": "4.8.0",
    "hash-wasm": "4.12.0",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
